<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Khám Phá Du Lịch Việt Nam</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      max-width: 700px;
      margin: 0 auto;
      padding: 20px;
      background-color: #f5f7fa;
      color: #222;
    }

    h1 {
      text-align: center;
      color: #00796b;
    }

    h2 {
      color: #333;
      margin-top: 30px;
    }

    ul {
      line-height: 1.8;
    }

    #image {
      width: 100%;
      max-width: 500px;
      height: 300px;
      margin: 0 auto;
      border: 3px solid #333;
      border-radius: 10px;
      background-color: #444;
      background-image: url('');
      background-size: cover;
      background-position: center;
      color: white;
      font-size: 24px;
      font-weight: bold;
      text-align: center;
      text-shadow: 2px 2px 6px rgba(0, 0, 0, 0.8);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 10px;
      box-sizing: border-box;
      transition: border-color 0.3s;
    }

    #counter {
      text-align: center;
      font-weight: bold;
      color: #00796b;
    }

    .gallery {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 10px;
      margin-top: 20px;
    }

    .preview {
      width: 120px;
      height: 80px;
      object-fit: cover;
      border-radius: 6px;
      border: 2px solid transparent;
      cursor: pointer;
      transition: transform 0.2s;
    }

    .preview:hover,
    .preview:focus {
      transform: scale(1.1);
      outline: none;
      border-color: #00796b;
    }
  </style>
</head>
<body>
  <h1>Khám Phá Du Lịch Việt Nam</h1>
  <h2>Một số địa danh nổi tiếng:</h2>

  <ul>
    <li>Vịnh Hạ Long</li>
    <li>Phố cổ Hội An</li>
    <li>Fansipan (Sa Pa)</li>
    <li>Phú Quốc</li>
  </ul>

  <h2>Hình ảnh các địa danh:</h2>

  <div id="image">Di chuột qua một hình ảnh bên dưới để hiển thị ở đây.</div>
  <p id="counter">Số lần bạn đã xem ảnh: 0</p>

  <div class="gallery">
    <img class="preview" alt="Vịnh Hạ Long" tabindex="0"
         src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcSScRj0v3N14IZQgcFFISgPC01H8cv7XzdcXFTZr0kw6Q&s=10"
         onmouseover="upDate(this)" onmouseleave="unDo()"
         onfocus="upDate(this)" onblur="unDo()">

    <img class="preview" alt="Phố cổ Hội An" tabindex="0"
         src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcR-DcG2OWd37J_0Cy6RvaGY2_RngtWDNxkslbGG_JAEqg&s=10"
         onmouseover="upDate(this)" onmouseleave="unDo()"
         onfocus="upDate(this)" onblur="unDo()">

    <img class="preview" alt="Fansipan Sa Pa" tabindex="0"
         src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQMRhUsxCDcjrqXwnp81T63BxB-HjIj0Ecb9_SasKcsVA&s=10"
         onmouseover="upDate(this)" onmouseleave="unDo()"
         onfocus="upDate(this)" onblur="unDo()">

    <img class="preview" alt="Phú Quốc" tabindex="0"
         src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcRz0uXDfjvM05Y3jpQkU_GwmaXSOwfL-yVruErGAseJIw&s=10"
         onmouseover="upDate(this)" onmouseleave="unDo()"
         onfocus="upDate(this)" onblur="unDo()">
  </div>

  <script>
    let viewCount = 0;

    const defaultText = "Di chuột qua một hình ảnh bên dưới để hiển thị ở đây.";

    function upDate(previewPic) {
      console.log("Sự kiện mouseover/focus đã kích hoạt");
      console.log("Alt: " + previewPic.alt);
      console.log("Src: " + previewPic.src);

      var imageDiv = document.getElementById("image");

      imageDiv.innerHTML = previewPic.alt;
      imageDiv.style.backgroundImage = 'url("' + previewPic.src + '")';
      imageDiv.style.borderColor = "red";

      viewCount = viewCount + 1;
      document.getElementById("counter").innerHTML =
        "Số lần bạn đã xem ảnh: " + viewCount;
    }

    function unDo() {
      console.log("Sự kiện mouseleave/blur đã kích hoạt");

      var imageDiv = document.getElementById("image");

      imageDiv.style.backgroundImage = "url('')";
      imageDiv.innerHTML = defaultText;
      imageDiv.style.borderColor = "#333";
    }
  </script>
</body>
</html>
